# Speech-to-text (Gemini Live transcription) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Translation EN→ES (Claude Haiku 4.5). Falls back to Gemini if empty.
ANTHROPIC_API_KEY=
SERVER_PORT=8080
# Optional: server URL as seen from browsers (default: same host, port 8080)
NEXT_PUBLIC_SERVER_URL=
# Optional: host/IP used in room QR codes (default: first LAN IPv4). Set it when running in Docker.
PUBLIC_HOST=
